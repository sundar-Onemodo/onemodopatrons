<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
      Globally permits cleartext HTTP (http://) for ALL IP addresses and domains in Release APK builds.
      This ensures that whether the IP changes to 192.168.1.74, 192.168.1.69, or any other subnet,
      Android will never block the connection.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
